{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stone0533/w_tools/main/packages/figma/schema/diff.v1.json",
  "title": "w_tools_figma.diff/1",
  "type": "object",
  "required": [
    "schema",
    "fileKey",
    "nodeId",
    "tierCalls",
    "changes",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "w_tools_figma.diff/1"
    },
    "fileKey": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "tierCalls": {
      "type": "integer",
      "minimum": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "name",
          "field",
          "before",
          "after"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "name",
          "added"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "added": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
