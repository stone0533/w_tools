{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stone0533/w_tools/main/packages/figma/schema/specs.v1.json",
  "title": "w_tools_figma.specs/1",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "w_tools_figma.specs/1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "nodeId",
          "node"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "node": {
            "type": "object"
          },
          "markdown": {
            "type": "string"
          },
          "sourceDepth": {
            "type": [
              "integer",
              "null"
            ]
          },
          "depthLimited": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "depthLimited": {
      "type": "boolean"
    },
    "staleAgainstDepth": {
      "type": "boolean"
    },
    "newerDepthAvailable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "source",
          "depth"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastModified": {
            "type": [
              "string",
              "null"
            ]
          },
          "fileKey": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
