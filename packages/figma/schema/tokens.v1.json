{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stone0533/w_tools/main/packages/figma/schema/tokens.v1.json",
  "title": "w_tools_figma.tokens/1",
  "type": "object",
  "required": [
    "schema",
    "source",
    "nodeIds",
    "counts",
    "markdown"
  ],
  "properties": {
    "schema": {
      "const": "w_tools_figma.tokens/1"
    },
    "source": {
      "type": "string"
    },
    "nodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "colors",
        "texts",
        "radii",
        "spacings"
      ],
      "properties": {
        "colors": {
          "type": "integer"
        },
        "texts": {
          "type": "integer"
        },
        "radii": {
          "type": "integer"
        },
        "spacings": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "count"],
        "properties": {
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "size",
          "weight",
          "lineHeight",
          "letterSpacing",
          "align",
          "color",
          "count"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          },
          "lineHeight": {
            "type": "string"
          },
          "letterSpacing": {
            "type": "string"
          },
          "align": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "radii": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "count"],
        "properties": {
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "spacings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "count"],
        "properties": {
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "markdown": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
